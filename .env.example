# Environment variables needed to run the agent.
#
# For readers and reviewers: this file lists every secret the agent needs, without values.
# To run the project, copy it to `.env` and fill in your own keys:
#     cp .env.example .env
# `.env` is git-ignored and must never be committed (a gitleaks check blocks it).

# Mistral AI Studio API key (console.mistral.ai -> API Keys). Used by the decision LLM.
MISTRAL_API_KEY=

# Alpaca PAPER trading keys (app.alpaca.markets -> switch to the Paper account -> API Keys).
# Paper keys start with "PK". The agent refuses to run against a live (real-money) account.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
